# PostgreSQL 16 Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres_db

# Redis Configuration (Future Phase)
REDIS_URL=redis://localhost:6379/0

# Environment & Server
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# API Versioning Prefix
API_V1_PREFIX=/task_management/api/v1

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-32-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@teamboard.com
FRONTEND_URL=http://localhost:3000

